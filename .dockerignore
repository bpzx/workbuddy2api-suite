# 构建上下文裁剪。
#
# 两类要排除的东西：
#   1. **影响构建正确性**的（数据目录、.env、node_modules、本地产物）——
#      这类必须排除，理由逐条写在下面；
#   2. **根本不是构建输入**的（项目根的说明文档、开发脚本、测试）。
#
# 关于第 2 类的收益，如实说：**体积上几乎可以忽略**（这些加起来约 276 KB，
# 而 `vendor/` 就要 11 MB，占比约 2%）。所以别为了"省空间"加它。
# 加它的真正理由是**把契约显式化**：将来有人写 `COPY README.md` 时，
# 构建会立刻失败并提示找不到文件，而不是把说明文档悄悄打进镜像。
#
# ⚠️ 本文件的模式**一律锚定**（前导 `/` 表示仓库根，或写完整相对路径）。
# 裸模式会匹配**任意层级**，例如裸 `LICENSE` 会连 `vendor/manager/LICENSE`
# 一起排除 —— 而那个文件是 Dockerfile 明确 COPY 的，表现是构建期报
# "文件不存在"，很难联想到是这个文件干的。同一条教训在根 `.gitignore` 上
# 已经吃过一次（上游 `.gitignore` 的 bare `*.md` 误伤了 `go:embed` 需要的文件），
# 那里现在也约定「所有模式一律锚定」。
#
# 锚定**不等于**安全：真正需要构建输入的路径（`vendor/`、`docker/`、
# `upstreams.json`）绝不能出现在下面。这一点由 `tests/test_dockerignore.py`
# 机械守住 —— 它解析 Dockerfile 的 COPY 源，逐个断言没有被本文件排除；
# 该测试自带正反例（裸 `LICENSE` 必须被判为"会误伤"），避免匹配器写错时空转。

# ── 必须排除：影响构建正确性 ─────────────────────────────
# ⚠️ 运行时数据目录必须排除。compose 默认把数据放在宿主机 ./data
# （WB_DATA_PATH），里面有账号凭证（含明文 refresh token）、含 api_key 与
# 设备 token 的 config.json、管理端密钥库。它们绝不能进构建上下文 ——
# 构建上下文会被整体发给 Docker daemon，即便 Dockerfile 从不 COPY 它。
# 这是改用宿主目录后新增的风险点（旧版用命名卷，数据不在项目目录里）。
data/
/data/

# ⚠️ 根目录 .env 同样含机密：WB_ADMIN_PASSWORD、代理凭据、容器内地址。
# 它不是构建输入（compose 在运行时读取它，与镜像构建无关）。
/.env
/.env.local

# ⚠️ node_modules 必须排除。Dockerfile 的 web 阶段先 `npm ci` 装依赖，
# 再 `COPY vendor/manager/web/ ./` 覆盖源码。若宿主的 node_modules 进了上下文，
# 这一步会用宿主（可能是别的平台/Node 版本）装出来的依赖盖掉容器里刚装好的，
# 产物在其他架构上会直接跑不起来，且报错很难指向这里。
vendor/manager/web/node_modules
vendor/manager/web/.next
vendor/manager/web/out
vendor/manager/web/.env
vendor/manager/web/.env.local

# wb2api 的本地编译产物与运行时数据（与上游 .dockerignore 口径一致）。
# config.json 尤其重要：真实配置含 api_key，绝不能进镜像。
vendor/wb2api/auths
vendor/wb2api/data
vendor/wb2api/config.json
vendor/wb2api/wb2api
vendor/wb2api/login
vendor/wb2api/credit
vendor/wb2api/signin_bin
vendor/wb2api/trial_bin
vendor/wb2api/activity_bin

# ── 项目根：除 upstreams.json 外都不是构建输入 ─────────────
# Dockerfile 从根目录只取 `upstreams.json`（烤进镜像 /opt/suite/ 作为血统记录），
# 其余根级条目一律不需要。加了这些之后，若将来有人写 `COPY README.md`，
# 构建会直接失败并提示找不到文件 —— 那正是我们想要的即时反馈。
#
# 注意 `/.github` 只排除仓库根的 CI 配置；`vendor/manager/.github` 必须保留
# （上游测试会读自己的 `.github/workflows/release.yml`）—— 锚定前缀让这两者
# 互不影响，这正是不能写裸 `.github` 的原因。
/README.md
/MAINTAINING.md
/UPSTREAMS.md
/CHANGELOG.md
/LICENSE
/.gitignore
/.dockerignore
/.env.example
/docker-compose.yml
/.github
/scripts
/tests

# ── 必须排除：体积 ────────────────────────────────────────
.git
# 同步脚本的裸仓库镜像（可能几十 MB，且是本机缓存）
.upstream-cache
# 嵌套的 .git 目录（vendor 快照里已排除，这里是双保险）
**/.git

# ── 缓存与杂物 ────────────────────────────────────────────
**/__pycache__
**/*.py[cod]
**/.venv
**/venv
**/.DS_Store
**/.idea
**/.vscode

# 本地跑测试/构建会在 vendor 快照里落下的产物（会破坏"快照 == 上游 commit"）。
# 正常情况下它们不该存在（.gitignore 也挡着），这里是双保险：
# 万一有人本地跑过测试就直接构建，至少不会把脏文件打进镜像。
vendor/manager/.version
vendor/manager/web/next-env.d.ts
