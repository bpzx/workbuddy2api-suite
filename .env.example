# ── workbuddy2api-suite 部署变量 ─────────────────────────
# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# ── 镜像 ────────────────────────────────────────────────
# 用 ghcr 上发布的镜像（默认）。
#
# 标签语义（CI 按此推送）：
#   latest        最新**正式版**（只在打 v* tag 时移动）—— 面板「一键更新」拉的就是它
#   v1.2.3/1.2.3  某个具体正式版（钉死，不移动）
#   main          最新 main 构建（跟随开发，非正式版）
#   sha-xxxxxxx   某次具体提交（钉死到提交，永不移动）
#
# 想让部署永远停在某个版本，就把下面这行换成固定 tag，例如：
#   SUITE_IMAGE=ghcr.io/bpzx/workbuddy2api-suite:v1.2.3
# 想跟随 main 的开发构建（不进面板的"正式版"体系）则用：
#   SUITE_IMAGE=ghcr.io/bpzx/workbuddy2api-suite:main
SUITE_IMAGE=ghcr.io/bpzx/workbuddy2api-suite:latest

# ── 版本检测（面板「系统更新」页）──────────────────────
# 面板分三段，别混淆它们：
#
#   1. 本套件        当前版本（来自 CI 的 git tag）→ 最新正式版
#                    这一块**带「一键更新」按钮**，更新的是本镜像。
#   2. 上游网关 workbuddy2api    固定 commit → 远端 HEAD
#   3. 上游管理端 workbuddy-manager  快照版本 → 上游最新 Release
#                    第 2、3 段**只报告"是否有更新"**，没有按钮 ——
#                    上游更新必须走宿主机：
#                        ./scripts/sync-upstreams.sh → 重建镜像 → compose pull && up -d
#
# ⚠️ 第 3 段显示的是**上游 workbuddy-manager 自己的版本号**（如 v1.0.57），
#    不是"本项目是 v1.0.57"。本项目的版本看第 1 段（形如 v1.2.3）。
#
# 检测无需在这里配置任何东西：套件仓库地址由镜像里的 WB_SUITE_REPO 提供
# （构建期取自 GITHUB_REPOSITORY），上游仓库地址取自 upstreams.json。

# ── 一键更新（updater 侧车）─────────────────────────────
# 面板上「本套件 → 一键更新」由 updater 侧车执行：它拉取新镜像并重建容器。
#
# 设置一个随机值即可启用：
#     openssl rand -hex 24
#
# **留空 = 拒绝所有更新请求**（安全默认）。此时侧车照常运行，但面板会显示
# 「一键更新不可用」并给出可在宿主机直接执行的命令 —— 这是可用的降级，
# 不是故障。
#
# ⚠️ 安全说明（务必了解）：updater 是**唯一**直连 /var/run/docker.sock 的组件
#    （重建容器必然需要），因此它等价于宿主机 root。之所以这样设计，是为了让
#    经 Cloudflare Tunnel **对外**的 manager 完全不碰 socket —— manager 只能向
#    侧车发一个**无参数**的固定触发请求（带本 token 校验），拿不到任意 docker
#    能力。这是"把能力收敛到最小侧车"的取舍，详见 README「一键更新与安全边界」。
#
# 不想要这个组件时，把 docker-compose.yml 里的 updater 服务整段注释掉即可。
SUITE_UPDATER_TOKEN=

# ── 对外端口与绑定地址 ──────────────────────────────────
# manager 是唯一对外入口（带密钥鉴权、配额、IP 管控、用量统计）。

# 绑定地址（谁能连上）：
#   0.0.0.0   = 所有网卡都能连（默认）
#   127.0.0.1 = 仅本机可连 —— 配合 Cloudflare Tunnel / 本机反向代理时的推荐值
MANAGER_BIND=0.0.0.0

# 宿主机端口
MANAGER_PORT=7864

# 说明：上游 wb2api 的 7863 有意不发布到宿主机。若确需直连，
# 见 README「直连上游网关」一节，并清楚其安全代价。

# ── 用 Cloudflare Tunnel 上线（推荐配置）─────────────────
# .env 里这样写：
#     MANAGER_BIND=127.0.0.1
#     MANAGER_PORT=7864
# cloudflared 的 ingress 指向 http://127.0.0.1:7864 即可。
#
# 另需设 WB_SECURE_COOKIE（见下方「安全」段）：
#   CF 会注入 X-Forwarded-Proto: https，保持 auto 即可让 Cookie 带上 Secure；
#   若保持默认 0.0.0.0 而不改绑定，7864 会同时对外网开放，Tunnel 的意义就没了。

# ── 数据目录（宿主机路径）───────────────────────────────
# 所有持久化数据都在这里：账号凭证、上游配置、池状态、管理端数据库。
# 用相对路径（./data）则落在项目目录下，宿主机可直接查看与备份：
#     ls -la ./data
# 也可写绝对路径，例如 /srv/workbuddy/data
#
# 首次启动若目录不存在会被自动创建（属主由容器入口脚本修正为 uid 10001）。
# 若宿主目录在 NFS / 只读挂载上，入口脚本无法 chown，需手工执行：
#     sudo chown -R 10001:10001 <该目录>
WB_DATA_PATH=./data

# ── 时区 ────────────────────────────────────────────────
# 上游的签到/旅行/夜猫任务按本地时点判定（04:00 重置、23:00–08:00 夜猫窗口），
# 改这个值会改变所有定时任务的实际触发时刻。
TZ=Asia/Shanghai

# ── 安全 ────────────────────────────────────────────────
# 首次启动的管理员密码。留空 → 随机生成并打印到容器日志：
#   docker compose logs manager | grep -iE 'password|密码'
WB_ADMIN_PASSWORD=
# 会话有效期（天）
WB_SESSION_DAYS=7
# Cookie 安全标志：auto 依 X-Forwarded-Proto 自动判断；
# 生产走 HTTPS 保持 auto；纯 HTTP 直连需显式设 false，否则浏览器不存 Cookie
WB_SECURE_COOKIE=auto
# 每密钥每分钟调用上限（0 = 不限）
WB_GATEWAY_RATE_PER_MIN=120
# 可信反向代理跳数：前面只有一层反代时保持 1；再挂 CDN 则设为 CDN+反代层数。
# 注意：不要把 7864 直接暴露公网，否则 IP 类管控与登录锁定会失去意义。
WB_TRUSTED_PROXY_HOPS=1

# ── 出口代理（可选）─────────────────────────────────────
# 留空 = 全部直连。
# 用于需要经代理才能访问腾讯的场景（受限网络、或用代理统一出口）。
# 支持 http:// 与 socks5://（socks5 需要 socksio，镜像已装 httpx[socks]）。
#
# 两个服务的代理行为**不同**，这是刻意的：
#
#   * manager（Python/httpx）：
#       - 直连腾讯的请求（扫码登录、签到、查积分、注册）走此代理；
#       - 调自己上游 wb2api:7863 的请求**不走代理**（内网地址绕代理必失败）。
#         该行为由 docker/patches/apply.py 注入的 mounts 保证。
#
#   * wb2api（Go 网关）：
#       - 出站走 HTTP_PROXY / HTTPS_PROXY（Go 标准库只认这两个 + NO_PROXY）；
#       - **不认 ALL_PROXY** —— 若你的代理只配在 ALL_PROXY 里，网关不会走代理。
#       - 该支持由 docker/patches/apply.py 注入（上游无此能力）。
#
# 示例：
#   WB_HTTP_PROXY=http://192.168.1.10:7890
#   WB_HTTP_PROXY=socks5://192.168.1.10:1080
WB_HTTP_PROXY=

# 不走代理的目标（主要供 wb2api 的 Go 侧使用；manager 侧内网直连已内置）。
# 默认已含回环与三个容器名，通常无需修改。
# 若上游网关需要经某个内网域名访问，把它加进来。
WB_NO_PROXY=127.0.0.1,localhost,wb2api,manager,dockerproxy
